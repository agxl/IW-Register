# Protect config.php and other sensitive files from direct web access
<FilesMatch "^(config\.php|.*\.log|.*\.json|.*\.log\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(data|logs)($|/) - [F,L]
</IfModule>
